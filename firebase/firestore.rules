rules_version = '2';
// Edifice deal pipeline. Every read needs a signed-in, verified Google account that has a
// users/{email} doc. Site data, meta and the private engine are written only by the daily
// pipeline's service account (the Admin SDK bypasses these rules); clients may only queue manual sites.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function signedIn() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function userPath(e) { return /databases/$(database)/documents/users/$(e); }
    function member() { return signedIn() && exists(userPath(email())); }
    function role() { return get(userPath(email())).data.role; }
    function editor() { return member() && role() in ['editor', 'admin']; }
    function admin() { return member() && role() == 'admin'; }
    function str(v, n) { return v is string && v.size() <= n; }
    function stages() {
      return ['New', 'Under Consideration', 'Reviewing', 'Contacted', 'In Diligence', 'LOI Submitted',
              'Under Contract', 'Closed', 'Passed', 'On Hold'];
    }

    // Manually added sites (Add site button). A client may only create a pending stub holding the raw
    // input; the enrichment job (service account) fills the record. Afterwards a client may only change
    // its hand edits (and so re-queue it). Pipeline docs (no manual flag) stay read-only.
    function manualId(id) { return id.matches('m-[a-z0-9-]{4,40}'); }
    function editsOk(m) { return m is map && m.size() <= 30 && m.keys().hasOnly(editKeys()); }
    function editKeys() {
      return ['name', 'address', 'city', 'county', 'zip', 'lat', 'lon', 'acres', 'parcels', 'owner', 'zoning',
              'price_total', 'price_per_acre', 'electric', 'gas', 'water', 'sewer', 'telecom', 'description', 'url',
              'appraised_value', 'water_sewer_detail', 'substation_detail'];
    }
    function manualCreateOk(id) {
      let d = request.resource.data;
      return manualId(id)
        && d.keys().hasOnly(['view', 'name', 'manual', 'status', 'input', 'created_by', 'created', 'edits'])
        && d.view == 'land' && d.manual == true && d.status == 'pending'
        && str(d.input, 2000) && d.input.size() > 0 && str(d.get('name', ''), 160)
        && d.created_by == email() && d.created == request.time
        && editsOk(d.get('edits', {}));
    }
    function manualEditOk() {
      let d = request.resource.data;
      return resource.data.manual == true
        && d.diff(resource.data).affectedKeys().hasOnly(['edits', 'edited_by', 'edited', 'status'])
        && d.status == 'pending' && editsOk(d.edits)
        && d.edited_by == email() && d.edited == request.time;
    }

    // Pipeline output: member-read only (plus manual-site stubs and hand edits, above).
    match /sites/{id} {
      allow read: if member();
      allow create: if editor() && manualCreateOk(id);
      allow update: if editor() && manualEditOk();
      allow delete: if admin() && resource.data.manual == true;
    }
    // Restricted (admin-only) sites, e.g. confidential deals under contract. Kept in their own
    // collections so non-admin list queries never touch them; admins only, enforced here.
    match /rsites/{id} {
      allow read: if admin();
      allow create: if admin() && manualCreateOk(id);
      allow update: if admin() && manualEditOk();
      allow delete: if admin();
    }
    match /meta/{id} { allow read: if member(); allow write: if false; }
    match /private/{id} { allow read: if member(); allow write: if false; }
    match /learnings/{id} { allow read: if member(); allow write: if false; }
    // Admin-only runtime config written by the pipeline (e.g. config/senders: the Gmail accounts allowed
    // to send from the app). Addresses are never in this file; they are set at runtime.
    match /config/{id} { allow read: if admin(); allow write: if false; }
    // Public Mapbox map token (URL-restricted pk.): readable by any signed-in member, never client-written.
    match /config/mapbox { allow read: if member(); allow write: if false; }
    function senders() {
      let p = /databases/$(database)/documents/config/senders;
      return exists(p) ? get(p).data.emails : [];
    }

    // Users: members can read the roster (names on notes); only admins manage it.
    // An admin cannot remove or demote themselves, so there is always at least one admin.
    match /users/{uemail} {
      allow read: if member();
      allow create: if admin() && uemail == uemail.lower()
        && request.resource.data.keys().hasOnly(['role', 'name', 'added_by', 'added'])
        && request.resource.data.role in ['admin', 'editor', 'viewer']
        && (!('name' in request.resource.data) || str(request.resource.data.name, 120));
      allow update: if admin()
        && request.resource.data.keys().hasOnly(['role', 'name', 'added_by', 'added', 'updated_by', 'updated'])
        && request.resource.data.role in ['admin', 'editor', 'viewer']
        && (!('name' in request.resource.data) || str(request.resource.data.name, 120))
        && (uemail != email() || request.resource.data.role == 'admin');
      allow delete: if admin() && uemail != email();
    }

    function dealOk(siteId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['site_id', 'view', 'name', 'stage', 'updated', 'updated_by'])
        && d.site_id == siteId && d.view in ['land', 'storage'] && d.stage in stages()
        && d.updated_by == email() && d.updated is timestamp;
    }
    function eventOk(siteId, eventId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['event_id', 'site_id', 'view', 'name', 'type', 'ts',
               'from_stage', 'to_stage', 'reasons', 'text', 'assignee', 'due', 'status', 'by'])
        && d.event_id == eventId && d.site_id == siteId && d.view in ['land', 'storage']
        && d.by == email() && d.ts is string && d.ts.size() <= 40
        && str(d.get('text', ''), 5000)
        && (
          (d.type == 'stage' && d.to_stage in stages()
            && d.reasons is list && d.reasons.size() >= 1 && d.reasons.size() <= 12)
          || (d.type == 'note' && d.text.size() > 0)
          || (d.type == 'followup' && d.text.size() > 0 && d.status == 'open'
            && str(d.get('assignee', ''), 80) && str(d.get('due', ''), 10))
        );
    }
    function fuFlipOk() {
      return resource.data.type == 'followup'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'done_at', 'done_by'])
        && request.resource.data.status in ['open', 'done']
        && (!('done_by' in request.resource.data) || request.resource.data.done_by in [email(), null]);
    }

    // deals/{siteId}: stage and current state.
    match /deals/{siteId} {
      allow read: if member();
      allow create, update: if editor() && dealOk(siteId);
      allow delete: if admin();

      // Stage changes (with reasons), notes, follow-ups. Authored as yourself; history is append-only
      // except a follow-up's status, which any editor can flip.
      match /events/{eventId} {
        allow read: if member();
        allow create: if editor() && eventOk(siteId, eventId);
        allow update: if editor() && fuFlipOk();
        allow delete: if admin();
      }
    }

    // Restricted deals (admin-only sites): same shape, admins only. The subcollection is named
    // 'revents' so the members' collection-group query on 'events' never includes it.
    match /rdeals/{siteId} {
      allow read: if admin();
      allow create, update: if admin() && dealOk(siteId);
      allow delete: if admin();
      match /revents/{eventId} {
        allow read: if admin();
        allow create: if admin() && eventOk(siteId, eventId);
        allow update: if admin() && fuFlipOk();
        allow delete: if admin();
      }
    }
    match /{path=**}/revents/{eventId} { allow read: if admin(); }

    // Review queue (admin-only): every stage change lands here so the admin can be asked why and the
    // answer feeds the learned weights. Editors may only file a pending item for their own stage change
    // (write-only for them); admins and the pipeline read, ask and answer.
    match /reviewQueue/{eventId} {
      allow read, delete: if admin();
      allow create: if editor() && reviewOk(eventId);
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'asked_at', 'answer', 'answered_at', 'answered_by', 'answer_event_id'])
        && request.resource.data.status in ['pending', 'asked', 'answered']
        && str(request.resource.data.get('answer', ''), 5000);
    }
    function reviewOk(eventId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['event_id', 'site_id', 'view', 'name', 'track', 'from_stage', 'to_stage', 'who', 'reasons', 'text', 'ts', 'status', 'restricted', 'created'])
        && d.event_id == eventId && str(d.site_id, 80) && d.view in ['land', 'storage']
        && d.track == (d.view == 'land' ? 'power' : 'storage')
        && d.to_stage in stages() && d.who == email() && d.status == 'pending'
        && d.reasons is list && d.reasons.size() <= 12 && str(d.get('text', ''), 5000) && str(d.get('name', ''), 200)
        && d.ts is string && d.ts.size() <= 40 && d.created == request.time
        && (d.get('restricted', false) == false || admin());
    }

    // Deal email log (admin-only). The sync job (service account) writes headers + a short excerpt, never
    // bodies. An admin who is also an allowed sender (config/senders) may log an in-app send and bump the
    // deal's last touch; the sending account must be one of the allowed senders too.
    match /dealEmails/{siteId} {
      allow read: if admin();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['site_id', 'last_touch', 'last_out', 'last_account', 'updated_by', 'summary', 'counts', 'updated', 'threads'])
        && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasOnly(['site_id', 'last_touch', 'last_out', 'last_account', 'updated_by'])
        && request.resource.data.site_id == siteId && request.resource.data.updated_by == email()
        && email() in senders() && request.resource.data.last_account in senders()
        && request.resource.data.last_touch == request.time && request.resource.data.last_out == request.time;
      allow delete: if admin();
      match /items/{itemId} {
        allow read, delete: if admin();
        allow create: if admin() && emailItemOk(siteId, itemId);
      }
    }
    function emailItemOk(siteId, itemId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['site_id', 'date', 'account', 'from', 'to', 'cc', 'subject', 'excerpt', 'link', 'thread_id', 'message_id', 'rfc_id', 'dir', 'source', 'by', 'created'])
        && d.site_id == siteId && d.source == 'app' && d.dir == 'out' && d.by == email()
        && email() in senders() && d.account in senders()
        && itemId == d.thread_id + '_' + d.message_id
        && str(d.thread_id, 40) && str(d.message_id, 40) && str(d.get('rfc_id', ''), 300)
        && str(d.from, 200) && str(d.to, 1000) && str(d.get('cc', ''), 1000) && str(d.subject, 300)
        && str(d.excerpt, 400) && str(d.link, 300)
        && d.link == 'https://mail.google.com/mail/u/?authuser=' + d.account + '#all/' + d.thread_id
        && d.date is string && d.date.size() <= 40 && d.created == request.time;
    }

    // Lets the realtime collection-group listener read every deal's events.
    match /{path=**}/events/{eventId} { allow read: if member(); }
  }
}
